# Copy to .env.local and fill in from your Supabase project (Project Settings > API / Database).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The app's public address, used for sign-in email links. Required in production
# (https, origin only). Defaults to http://localhost:3000 in development.
# NEXT_PUBLIC_SITE_URL=https://reptr-three.vercel.app

# Server only. Use the pooler connection string (port 6543) for the app,
# and the direct connection (port 5432) when running migrations.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Local only: a throwaway Postgres for the database tests. They wipe it.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/reptr_test

# Local only: run `pnpm dev` without Supabase by acting as this user id (a row must
# exist in auth.users). Ignored in production builds and when Supabase is configured.
# REPTR_DEV_USER_ID=00000000-0000-0000-0000-000000000001
# Local only: look around the sample account filled by `pnpm db:demo` instead.
# REPTR_DEMO=1
# Local only: let REPTR_DEV_USER_ID work in a production build on your own machine.
# REPTR_LOCAL=1

# Server only: turns on the AI coach. OPENAI_MODEL is optional.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# Server only, optional: errors are always logged as JSON lines; set this to also POST each
# one to a webhook (a Slack or Discord incoming webhook, or an error tracker's ingest URL).
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...

# Server only, optional: AI coach limits. Defaults shown. Prices are USD per 1M tokens for
# OPENAI_MODEL; update them if you change the model.
# COACH_DAILY_BUDGET_USD=5
# COACH_USER_DAILY_TOKENS=200000
# COACH_MAX_OUTPUT_TOKENS=900
# COACH_HISTORY_CHARS=16000
# COACH_PRICE_INPUT=0.4
# COACH_PRICE_OUTPUT=1.6
