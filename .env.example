# Copy to .env.local and fill in from your Supabase project (Project Settings > API / Database).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Use the pooler connection string (port 6543) for the app,
# and the direct connection (port 5432) when running migrations.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Local only: a throwaway Postgres for the database tests. They wipe it.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/reptr_test
